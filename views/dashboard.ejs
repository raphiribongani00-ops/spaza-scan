<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #f5f5f5;
            padding: 20px;
        }
        
        .header {
            background: #FFD700;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 28px;
            color: #333;
        }
        
        .welcome-text {
            margin-top: 8px;
            color: #666;
            font-size: 14px;
        }
        
        .menu {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .menu-card {
            background: white;
            padding: 25px 15px;
            border-radius: 15px;
            text-align: center;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            text-decoration: none;
            color: #333;
            display: block;
        }
        
        .menu-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }
        
        .menu-card .icon {
            font-size: 48px;
            margin-bottom: 10px;
        }
        
        .menu-card h3 {
            font-size: 18px;
            margin-bottom: 5px;
        }
        
        .menu-card p {
            font-size: 12px;
            color: #999;
        }
        
        .info-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .info-card h2 {
            font-size: 18px;
            margin-bottom: 15px;
            color: #333;
            border-left: 4px solid #FFD700;
            padding-left: 12px;
        }
        
        .info-card p {
            color: #666;
            margin-bottom: 10px;
            line-height: 1.5;
        }
        
        .info-card .step {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }
        
        .info-card .step-number {
            background: #FFD700;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 12px;
            color: #333;
        }
        
        .logout-btn {
            background: #dc3545;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 12px;
            width: 100%;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        
        .logout-btn:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🛍️ SpazaScan</h1>
        <p class="welcome-text">Welcome to your customer dashboard</p>
    </div>
    
    <div class="menu">
        <a href="/scanner" class="menu-card">
            <div class="icon">📷</div>
            <h3>Scan Barcode</h3>
            <p>Scan product barcodes to add to cart</p>
        </a>
        
        <a href="/order-history" class="menu-card">
            <div class="icon">📦</div>
            <h3>Order History</h3>
            <p>View your past orders</p>
        </a>
    </div>
    
    <div class="info-card">
        <h2>How to Shop</h2>
        <div class="step">
            <span class="step-number">1</span>
            <span>Scan a shop QR code at any spaza shop</span>
        </div>
        <div class="step">
            <span class="step-number">2</span>
            <span>Scan product barcodes to add items to your cart</span>
        </div>
        <div class="step">
            <span class="step-number">3</span>
            <span>Checkout and show your order QR to the merchant</span>
        </div>
        <div class="step">
            <span class="step-number">4</span>
            <span>Merchant verifies and releases your order</span>
        </div>
    </div>
    
    <button class="logout-btn" onclick="logout()">Logout</button>
    
    <script>
        async function logout() {
            try {
                await fetch('/api/customer/logout', { method: 'POST' });
                window.location.href = '/';
            } catch (error) {
                console.error('Logout error:', error);
                window.location.href = '/';
            }
        }
    </script>
</body>
</html>