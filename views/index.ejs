<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .container {
            background: white;
            border-radius: 30px;
            padding: 40px 30px;
            width: 100%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        
        .logo h1 {
            font-size: 48px;
            color: #FFD700;
            margin-bottom: 10px;
        }
        
        .logo p {
            color: #666;
            font-size: 14px;
        }
        
        .role-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin: 30px 0;
        }
        
        .btn {
            padding: 16px;
            border: none;
            border-radius: 15px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .btn-customer {
            background: #FFD700;
            color: #333;
        }
        
        .btn-merchant {
            background: #333;
            color: white;
        }
        
        .btn-admin {
            background: #dc3545;
            color: white;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .test-credentials {
            margin-top: 30px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
            font-size: 12px;
            color: #666;
        }
        
        .test-credentials h4 {
            margin-bottom: 10px;
            color: #333;
        }
        
        .test-credentials p {
            margin: 5px 0;
        }
        
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <h1><%= title %></h1>
            <p>Shop Smart, Scan Fast</p>
        </div>
        
        <div class="role-buttons">
            <button class="btn btn-customer" onclick="window.location.href='/customer-login'">
                I am a Customer
            </button>
            <button class="btn btn-merchant" onclick="window.location.href='/merchant-login'">
                I am a Merchant
            </button>
            <button class="btn btn-admin" onclick="window.location.href='/admin/login'">
                Admin Portal
            </button>
        </div>
        
        <div class="test-credentials">
            <h4>Test Accounts</h4>
            <p><strong>Customer:</strong> Phone: 0821234567, Password: 123456</p>
            <p><strong>Merchant:</strong> Phone: 0821234568, Password: 123456</p>
            <p><strong>Admin:</strong> Email: admin@spazapay.com, Password: Admin@123</p>
        </div>
        
        <div class="footer">
            <p>Scan products. Shop faster. Save money.</p>
        </div>
    </div>
</body>
</html>