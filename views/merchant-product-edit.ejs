<!DOCTYPE html>
<html>
<head>
    <title>Edit Product - Spaza Scan</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: white;
            padding: 16px;
            padding-bottom: 80px;
            color: black;
        }
        
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
        
        h1 {
            font-size: 24px;
            color: black;
            margin-bottom: 8px;
        }
        
        .card {
            background-color: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border: 1px solid #eee;
        }
        
        .form-group {
            margin-bottom: 16px;
        }
        
        label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: black;
            margin-bottom: 6px;
        }
        
        input {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: inherit;
            color: black;
        }
        
        input:focus {
            outline: none;
            border-color: #FFD700;
        }
        
        .current-image {
            margin: 10px 0;
            padding: 10px;
            background-color: #f5f5f5;
            border-radius: 8px;
            text-align: center;
        }
        
        .current-image img {
            max-width: 100px;
            border-radius: 8px;
        }
        
        button {
            background-color: #FFD700;
            color: black;
            border: none;
            padding: 14px 20px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            margin-bottom: 12px;
        }
        
        button:hover {
            background-color: #e6c200;
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: black;
            text-decoration: none;
            font-weight: 500;
        }
        
        .back-link:hover {
            color: #FFD700;
        }
        
        .welcome-text {
            font-size: 14px;
            color: #666;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Product</h1>
        <p class="welcome-text">Update product details</p>
        
        <div class="card">
            <form method="POST" action="/merchant-products/edit/<%= product.id %>" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Product Photo</label>
                    <input type="file" name="product_photo" accept="image/*">
                    <input type="hidden" name="existing_picture" value="<%= product.picture %>">
                    <% if (product.picture) { %>
                        <div class="current-image">
                            <p>Current photo:</p>
                            <img src="<%= product.picture %>" alt="Current product photo">
                        </div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Barcode</label>
                    <input type="text" name="barcode" value="<%= product.barcode %>" required>
                </div>
                
                <div class="form-group">
                    <label>Product Name</label>
                    <input type="text" name="name" value="<%= product.name %>" required>
                </div>
                
                <div class="form-group">
                    <label>Price (R)</label>
                    <input type="number" step="0.01" name="price" value="<%= product.price %>" required>
                </div>
                
                <button type="submit">Save Changes</button>
            </form>
        </div>
        
        <a href="/merchant-products" class="back-link">Back to Products</a>
    </div>
</body>
</html>