<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f5f5f5; padding: 20px; }
        .header { background: #333; padding: 20px; border-radius: 15px; margin-bottom: 20px; text-align: center; color: white; }
        .header h1 { font-size: 24px; margin-bottom: 5px; }
        .welcome-text { font-size: 14px; opacity: 0.9; }
        .qr-container { background: white; border-radius: 20px; padding: 30px; text-align: center; margin-bottom: 20px; }
        .qr-code { margin: 20px 0; }
        .qr-code img { width: 200px; height: 200px; }
        .shop-info { margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 10px; }
        .download-btn, .print-btn { padding: 12px 20px; border: none; border-radius: 10px; font-size: 16px; cursor: pointer; margin: 5px; }
        .download-btn { background: #FFD700; color: #333; }
        .print-btn { background: #666; color: white; }
        .back-btn { background: #dc3545; color: white; padding: 12px; border: none; border-radius: 10px; width: 100%; font-size: 16px; cursor: pointer; margin-top: 10px; }
        .loading { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Shop QR Code</h1>
        <p class="welcome-text"><%= shop_name %></p>
    </div>
    
    <div id="qr-container" class="qr-container"><div class="loading">Loading QR code...</div></div>
    
    <button class="back-btn" onclick="window.location.href='/merchant-dashboard'">← Back to Dashboard</button>
    
    <script>
        async function loadQRCode() {
            try {
                const response = await fetch('/api/merchant/shop-qr');
                const data = await response.json();
                if (data.qrCode) {
                    document.getElementById('qr-container').innerHTML = `
                        <h3>Scan this QR code to shop at your store</h3>
                        <div class="qr-code"><img src="${data.qrCode}" alt="Shop QR Code"></div>
                        <div class="shop-info"><p><strong>Shop:</strong> <%= shop_name %></p><p>Customers scan this QR code to identify your shop and start shopping.</p></div>
                        <button class="download-btn" onclick="downloadQR()">Download QR Code</button>
                        <button class="print-btn" onclick="window.print()">Print QR Code</button>
                    `;
                } else { document.getElementById('qr-container').innerHTML = '<div class="loading">Error generating QR code</div>'; }
            } catch (error) { document.getElementById('qr-container').innerHTML = '<div class="loading">Error generating QR code</div>'; }
        }
        function downloadQR() { const img = document.querySelector('.qr-code img'); if(img) { const link = document.createElement('a'); link.download = 'shop-qr-code.png'; link.href = img.src; link.click(); } }
        loadQRCode();
    </script>
</body>
</html>