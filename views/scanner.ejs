<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f5f5f5; padding: 20px; }
        .header { background: #FFD700; padding: 20px; border-radius: 15px; margin-bottom: 20px; text-align: center; }
        .header h1 { font-size: 24px; color: #333; }
        
        .main-buttons { display: flex; flex-direction: column; gap: 15px; margin-bottom: 20px; }
        .btn-main { padding: 20px; border: none; border-radius: 15px; font-size: 20px; font-weight: bold; cursor: pointer; transition: transform 0.2s; }
        .btn-main:active { transform: scale(0.98); }
        .btn-shop { background: #333; color: white; }
        .btn-scan { background: #FFD700; color: #333; display: none; }
        .btn-done { background: #00b894; color: white; display: none; }
        
        .scanner-container { background: #000; border-radius: 15px; overflow: hidden; margin-bottom: 20px; position: relative; min-height: 400px; display: none; }
        .scanner-container.active { display: block; }
        #video { width: 100%; height: 400px; display: block; background: #000; object-fit: cover; }
        .scan-frame { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 280px; height: 280px; border: 2px solid #FFD700; border-radius: 20px; pointer-events: none; }
        .camera-status { position: absolute; bottom: 10px; left: 10px; background: rgba(0,0,0,0.8); color: #00ff00; padding: 5px 10px; border-radius: 5px; font-size: 12px; }
        
        .camera-controls { display: flex; gap: 10px; margin-bottom: 20px; display: none; }
        .camera-controls button { flex: 1; padding: 12px; background: #333; color: white; border: none; border-radius: 10px; cursor: pointer; }
        
        .manual-input { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; display: none; }
        .input-group { display: flex; gap: 10px; }
        input { flex: 1; padding: 14px; border: 2px solid #e0e0e0; border-radius: 12px; font-size: 16px; }
        .btn-primary { padding: 14px 20px; background: #FFD700; border: none; border-radius: 12px; font-size: 16px; font-weight: bold; cursor: pointer; }
        
        .shop-info { background: #e8f5e9; padding: 15px; border-radius: 15px; margin-bottom: 20px; display: none; }
        .shop-info.active { display: block; }
        
        .cart-area { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; display: none; }
        .cart-area.active { display: block; }
        .cart-area h3 { margin-bottom: 15px; }
        .cart-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee; }
        .cart-item-name { font-weight: 500; }
        .cart-item-price { font-size: 12px; color: #FFD700; }
        .qty-btn { width: 30px; height: 30px; border-radius: 8px; border: none; background: #f0f0f0; font-size: 18px; cursor: pointer; margin: 0 5px; }
        .cart-total { text-align: right; font-weight: bold; margin-top: 15px; padding-top: 15px; border-top: 2px solid #FFD700; }
        
        .checkout-area { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; display: none; }
        .checkout-area.active { display: block; }
        .checkout-total { font-size: 28px; font-weight: bold; color: #FFD700; text-align: center; margin: 20px 0; }
        .btn-checkout { width: 100%; padding: 16px; background: #00b894; color: white; border: none; border-radius: 12px; font-size: 18px; font-weight: bold; cursor: pointer; }
        .btn-back { width: 100%; padding: 12px; background: #666; color: white; border: none; border-radius: 12px; font-size: 16px; cursor: pointer; margin-top: 10px; }
        
        .back-dashboard { width: 100%; padding: 12px; background: #dc3545; color: white; border: none; border-radius: 12px; font-size: 16px; cursor: pointer; margin-top: 10px; }
        .scan-result { position: fixed; bottom: 20px; left: 20px; right: 20px; background: #333; color: white; padding: 12px; border-radius: 10px; text-align: center; display: none; z-index: 1000; }
        .item-popup { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #00b894; color: white; padding: 20px; border-radius: 20px; text-align: center; z-index: 2000; animation: fadeOut 1.5s ease; pointer-events: none; }
        @keyframes fadeOut { 0% { opacity: 1; } 100% { opacity: 0; } }
        .empty-cart { text-align: center; padding: 30px; color: #999; }
    </style>
</head>
<body>
    <div class="header"><h1>Scan & Shop</h1></div>
    
    <div class="main-buttons">
        <button class="btn-main btn-shop" id="btnShop" onclick="startShopScan()">📍 STEP 1: SCAN SHOP QR</button>
        <button class="btn-main btn-scan" id="btnScan" onclick="startItemScan()">📷 STEP 2: SCAN ITEMS</button>
        <button class="btn-main btn-done" id="btnDone" onclick="showCheckout()">✅ STEP 3: DONE - VIEW CART</button>
    </div>
    
    <div class="scanner-container" id="scannerContainer">
        <video id="video" autoplay playsinline muted></video>
        <div class="scan-frame"></div>
        <div class="camera-status" id="cameraStatus">Camera off</div>
    </div>
    
    <div class="camera-controls" id="cameraControls">
        <button onclick="stopCamera()">Stop Camera</button>
        <button onclick="switchCamera()">Switch Camera</button>
    </div>
    
    <div class="manual-input" id="manualDiv">
        <h3>Manual entry (testing):</h3>
        <div class="input-group">
            <input type="text" id="manualInput" placeholder="Enter QR or barcode">
            <button class="btn-primary" onclick="manualEntry()">Add</button>
        </div>
    </div>
    
    <div id="shopInfo" class="shop-info">
        <h3>🏪 <span id="shopName"></span></h3>
        <p>Shop detected! Ready to scan items.</p>
    </div>
    
    <div class="cart-area" id="cartArea">
        <h3>🛒 Your Cart</h3>
        <div id="cartList"><div class="empty-cart">No items yet</div></div>
        <div id="cartTotalDisplay"></div>
    </div>
    
    <div class="checkout-area" id="checkoutArea">
        <h3>📋 Order Summary</h3>
        <div id="checkoutList"></div>
        <div class="checkout-total" id="checkoutTotalDisplay"></div>
        <button class="btn-checkout" onclick="placeOrder()">💳 CONFIRM & CHECKOUT</button>
        <button class="btn-back" onclick="hideCheckout()">← Back to Shopping</button>
    </div>
    
    <button class="back-dashboard" onclick="window.location.href='/customer-dashboard'">← Back to Dashboard</button>
    <div id="scanResult" class="scan-result"></div>
    
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script>
        let cart = [];
        let currentMerchantId = null;
        let stream = null;
        let currentCamera = 'environment';
        let isCameraActive = false;
        let animationId = null;
        let isScanningQR = true;
        let lastScan = '';
        let lastScanTime = 0;
        
        const video = document.getElementById('video');
        const statusDiv = document.getElementById('cameraStatus');
        const scannerContainer = document.getElementById('scannerContainer');
        const btnShop = document.getElementById('btnShop');
        const btnScan = document.getElementById('btnScan');
        const btnDone = document.getElementById('btnDone');
        
        function showMessage(msg, type) {
            const div = document.getElementById('scanResult');
            div.textContent = msg;
            div.className = 'scan-result ' + (type || 'success');
            div.style.display = 'block';
            setTimeout(() => div.style.display = 'none', 2000);
        }
        
        function showPopup(msg) {
            const popup = document.createElement('div');
            popup.className = 'item-popup';
            popup.innerHTML = '✅ ' + msg;
            document.body.appendChild(popup);
            setTimeout(() => popup.remove(), 1500);
        }
        
        async function startShopScan() {
            isScanningQR = true;
            await startCamera();
            showMessage('Scan Shop QR code...', 'success');
        }
        
        async function startItemScan() {
            if (!currentMerchantId) {
                showMessage('Please scan a Shop QR first!', 'error');
                return;
            }
            isScanningQR = false;
            await startCamera();
            showMessage('Scan product barcodes...', 'success');
        }
        
        async function startCamera() {
            if (isCameraActive) stopCamera();
            
            scannerContainer.classList.add('active');
            document.getElementById('cameraControls').style.display = 'flex';
            document.getElementById('manualDiv').style.display = 'block';
            statusDiv.textContent = 'Starting...';
            
            try {
                if (stream) stream.getTracks().forEach(t => t.stop());
                if (animationId) cancelAnimationFrame(animationId);
                
                const constraints = { video: { facingMode: currentCamera } };
                stream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = stream;
                
                video.onloadedmetadata = () => {
                    video.play();
                    isCameraActive = true;
                    statusDiv.textContent = 'Ready - scanning...';
                    statusDiv.style.color = '#00ff00';
                    startScanLoop();
                };
            } catch(err) {
                statusDiv.textContent = 'Camera error';
                showMessage('Camera error: ' + err.message, 'error');
                scannerContainer.classList.remove('active');
            }
        }
        
        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(t => t.stop());
                video.srcObject = null;
                isCameraActive = false;
                if (animationId) cancelAnimationFrame(animationId);
                statusDiv.textContent = 'Camera off';
                scannerContainer.classList.remove('active');
                document.getElementById('cameraControls').style.display = 'none';
                document.getElementById('manualDiv').style.display = 'none';
            }
        }
        
        function startScanLoop() {
            function scan() {
                if (!isCameraActive || video.readyState !== 4 || !video.videoWidth) {
                    if (isCameraActive) animationId = requestAnimationFrame(scan);
                    return;
                }
                
                const canvas = document.createElement('canvas');
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0);
                const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                
                const code = jsQR(imgData.data, imgData.width, imgData.height);
                if (code && code.data) {
                    const now = Date.now();
                    if (now - lastScanTime > 1500 && code.data !== lastScan) {
                        lastScanTime = now;
                        lastScan = code.data;
                        handleScan(code.data);
                    }
                }
                
                if (!isScanningQR && 'BarcodeDetector' in window) {
                    const detector = new BarcodeDetector();
                    detector.detect(canvas).then(barcodes => {
                        if (barcodes.length) {
                            const now = Date.now();
                            if (now - lastScanTime > 1500 && barcodes[0].rawValue !== lastScan) {
                                lastScanTime = now;
                                lastScan = barcodes[0].rawValue;
                                handleScan(barcodes[0].rawValue);
                            }
                        }
                    }).catch(() => {});
                }
                
                animationId = requestAnimationFrame(scan);
            }
            scan();
        }
        
        function handleScan(data) {
            if (isScanningQR) {
                processShopQR(data);
            } else {
                processProductBarcode(data);
            }
        }
        
        async function processShopQR(data) {
            try {
                const json = JSON.parse(data);
                if (json.type === 'shop') {
                    currentMerchantId = json.merchantId;
                    document.getElementById('shopName').innerText = json.shopName;
                    document.getElementById('shopInfo').classList.add('active');
                    document.getElementById('cartArea').classList.add('active');
                    showPopup(`Shop: ${json.shopName}`);
                    showMessage(`✓ Shopping at ${json.shopName}!`, 'success');
                    
                    stopCamera();
                    
                    btnShop.style.display = 'none';
                    btnScan.style.display = 'block';
                    btnDone.style.display = 'block';
                    return;
                }
            } catch(e) {}
            showMessage('Invalid QR - please scan a Shop QR code', 'error');
        }
        
        async function processProductBarcode(barcode) {
            if (!currentMerchantId) {
                showMessage('Please scan Shop QR first', 'error');
                return;
            }
            try {
                const res = await fetch(`/api/product/barcode/${barcode}`);
                if (res.ok) {
                    const product = await res.json();
                    addToCart(product);
                    showPopup(`${product.name} added!`);
                    showMessage(`✓ Added: ${product.name} - R${product.price}`, 'success');
                } else {
                    showPopup(`Product not found`, false);
                    showMessage(`✗ Product not found: ${barcode}`, 'error');
                }
            } catch(e) {
                showMessage('Error finding product', 'error');
            }
        }
        
        function addToCart(product) {
            const existing = cart.find(i => i.id === product.id);
            if (existing) existing.quantity++;
            else cart.push({ ...product, quantity: 1 });
            updateCartUI();
        }
        
        function updateQuantity(idx, change) {
            const newQty = cart[idx].quantity + change;
            if (newQty <= 0) cart.splice(idx, 1);
            else cart[idx].quantity = newQty;
            updateCartUI();
        }
        
        function updateCartUI() {
            const container = document.getElementById('cartList');
            const totalDiv = document.getElementById('cartTotalDisplay');
            
            if (!cart.length) {
                container.innerHTML = '<div class="empty-cart">No items yet</div>';
                totalDiv.innerHTML = '';
                return;
            }
            
            container.innerHTML = cart.map((item, idx) => `
                <div class="cart-item">
                    <div>
                        <div class="cart-item-name">${escapeHtml(item.name)}</div>
                        <div class="cart-item-price">R${item.price} each</div>
                    </div>
                    <div>
                        <button class="qty-btn" onclick="updateQuantity(${idx}, -1)">-</button>
                        <span>${item.quantity}</span>
                        <button class="qty-btn" onclick="updateQuantity(${idx}, 1)">+</button>
                    </div>
                </div>
            `).join('');
            
            const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            totalDiv.innerHTML = `<div class="cart-total">Total: R${total.toFixed(2)}</div>`;
            saveToLocal();
        }
        
        function showCheckout() {
            if (!cart.length) {
                showMessage('Cart is empty! Add items first.', 'error');
                return;
            }
            const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            document.getElementById('checkoutList').innerHTML = cart.map(item => `
                <div class="cart-item">
                    <span>${escapeHtml(item.name)} x ${item.quantity}</span>
                    <span>R${(item.price * item.quantity).toFixed(2)}</span>
                </div>
            `).join('');
            document.getElementById('checkoutTotalDisplay').innerHTML = `R${total.toFixed(2)}`;
            document.getElementById('checkoutArea').classList.add('active');
            document.getElementById('cartArea').style.display = 'none';
            btnScan.style.display = 'none';
            btnDone.style.display = 'none';
            stopCamera();
        }
        
        function hideCheckout() {
            document.getElementById('checkoutArea').classList.remove('active');
            document.getElementById('cartArea').style.display = 'block';
            btnScan.style.display = 'block';
            btnDone.style.display = 'block';
        }
        
        async function placeOrder() {
            if (!currentMerchantId) return;
            const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const btn = document.querySelector('.btn-checkout');
            btn.textContent = 'Processing...';
            btn.disabled = true;
            
            try {
                const res = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ merchantId: currentMerchantId, items: cart, total })
                });
                const data = await res.json();
                if (data.success) {
                    showPopup(`Order placed! R${total.toFixed(2)}`);
                    showMessage(`✓ Order placed! Total: R${total.toFixed(2)}`, 'success');
                    
                    const win = window.open();
                    win.document.write(`
                        <html><head><title>Order QR</title><meta name="viewport" content="width=device-width,initial-scale=1"></head>
                        <body style="display:flex;justify-content:center;align-items:center;min-height:100vh;font-family:sans-serif;background:#f5f5f5;margin:0;padding:20px">
                        <div style="text-align:center;background:white;padding:30px;border-radius:20px">
                            <h2>✅ Order Placed!</h2>
                            <img src="${data.orderQr}" style="width:300px;max-width:100%">
                            <p>Show this QR to the merchant</p>
                            <button onclick="window.close()" style="margin-top:20px;padding:12px 24px;background:#FFD700;border:none;border-radius:10px">Close</button>
                        </div>
                        </body></html>
                    `);
                    
                    cart = [];
                    currentMerchantId = null;
                    updateCartUI();
                    document.getElementById('shopInfo').classList.remove('active');
                    document.getElementById('cartArea').style.display = 'none';
                    document.getElementById('checkoutArea').classList.remove('active');
                    btnShop.style.display = 'block';
                    btnScan.style.display = 'none';
                    btnDone.style.display = 'none';
                    saveToLocal();
                    stopCamera();
                } else {
                    showMessage('Order failed', 'error');
                }
            } catch(e) {
                showMessage('Error placing order', 'error');
            } finally {
                btn.textContent = '💳 CONFIRM & CHECKOUT';
                btn.disabled = false;
            }
        }
        
        async function manualEntry() {
            const input = document.getElementById('manualInput').value;
            if (!input) return;
            if (isScanningQR) await processShopQR(input);
            else await processProductBarcode(input);
            document.getElementById('manualInput').value = '';
        }
        
        async function switchCamera() {
            if (!isCameraActive) {
                showMessage('Camera not active', 'error');
                return;
            }
            currentCamera = currentCamera === 'environment' ? 'user' : 'environment';
            await startCamera();
            showMessage(`Switched to ${currentCamera === 'environment' ? 'back' : 'front'} camera`, 'success');
        }
        
        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
        
        function saveToLocal() {
            localStorage.setItem('spaza_cart', JSON.stringify(cart));
            if (currentMerchantId) {
                localStorage.setItem('spaza_merchant', JSON.stringify({ id: currentMerchantId, name: document.getElementById('shopName').innerText }));
            } else {
                localStorage.removeItem('spaza_merchant');
            }
        }
        
        function loadFromLocal() {
            const savedCart = localStorage.getItem('spaza_cart');
            const savedMerchant = localStorage.getItem('spaza_merchant');
            if (savedCart) {
                try { cart = JSON.parse(savedCart); updateCartUI(); } catch(e) {}
            }
            if (savedMerchant) {
                try {
                    const m = JSON.parse(savedMerchant);
                    currentMerchantId = m.id;
                    document.getElementById('shopName').innerText = m.name;
                    document.getElementById('shopInfo').classList.add('active');
                    document.getElementById('cartArea').classList.add('active');
                    btnShop.style.display = 'none';
                    btnScan.style.display = 'block';
                    btnDone.style.display = 'block';
                } catch(e) {}
            }
        }
        
        loadFromLocal();
    </script>
</body>
</html>