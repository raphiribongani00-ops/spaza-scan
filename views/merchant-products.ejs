<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f5f5f5; padding: 20px; }
        .header { background: #333; padding: 20px; border-radius: 15px; margin-bottom: 20px; text-align: center; color: white; }
        .header h1 { font-size: 24px; margin-bottom: 5px; }
        .welcome-text { font-size: 14px; opacity: 0.9; }
        .add-btn { background: #FFD700; color: #333; padding: 12px; border: none; border-radius: 10px; width: 100%; font-size: 16px; font-weight: bold; cursor: pointer; margin-bottom: 20px; }
        .product-card { background: white; border-radius: 15px; padding: 15px; margin-bottom: 15px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .product-image { width: 70px; height: 70px; background: #f0f0f0; border-radius: 10px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .product-image img { width: 100%; height: 100%; object-fit: cover; }
        .product-info { flex: 1; }
        .product-name { font-weight: bold; margin-bottom: 5px; }
        .product-barcode { font-size: 12px; color: #999; }
        .product-price { color: #FFD700; font-weight: bold; }
        .product-actions { display: flex; gap: 10px; }
        .edit-btn, .delete-btn { padding: 8px 12px; border: none; border-radius: 8px; cursor: pointer; }
        .edit-btn { background: #FFD700; color: #333; }
        .delete-btn { background: #dc3545; color: white; }
        .back-btn { background: #666; color: white; padding: 12px; border: none; border-radius: 10px; width: 100%; font-size: 16px; cursor: pointer; margin-top: 10px; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: white; border-radius: 20px; padding: 20px; width: 90%; max-width: 400px; }
        .modal-content h3 { margin-bottom: 15px; }
        .modal-content input, .modal-content select { width: 100%; padding: 12px; margin-bottom: 10px; border: 2px solid #e0e0e0; border-radius: 10px; }
        .modal-buttons { display: flex; gap: 10px; margin-top: 15px; }
        .save-btn { background: #FFD700; padding: 10px; border: none; border-radius: 8px; flex: 1; cursor: pointer; }
        .cancel-btn { background: #999; color: white; padding: 10px; border: none; border-radius: 8px; flex: 1; cursor: pointer; }
        .loading { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="header">
        <h1>My Products</h1>
        <p class="welcome-text">Welcome, <%= shop_name %>!</p>
    </div>
    
    <button class="add-btn" onclick="showAddModal()">+ Add New Product</button>
    
    <div id="products-container"><div class="loading">Loading products...</div></div>
    
    <button class="back-btn" onclick="window.location.href='/merchant-dashboard'">← Back to Dashboard</button>
    
    <div id="addModal" class="modal">
        <div class="modal-content">
            <h3>Add New Product</h3>
            <input type="text" id="productBarcode" placeholder="Barcode">
            <input type="text" id="productName" placeholder="Product Name">
            <input type="number" id="productPrice" placeholder="Price (R)">
            <input type="file" id="productPicture" accept="image/*">
            <div class="modal-buttons">
                <button class="save-btn" onclick="addProduct()">Save</button>
                <button class="cancel-btn" onclick="closeModal()">Cancel</button>
            </div>
        </div>
    </div>
    
    <script>
        let products = [];
        async function loadProducts() {
            try {
                const response = await fetch('/api/merchant/products');
                products = await response.json();
                displayProducts();
            } catch (error) {
                document.getElementById('products-container').innerHTML = '<div class="loading">Error loading products</div>';
            }
        }
        function displayProducts() {
            const container = document.getElementById('products-container');
            if (products.length === 0) {
                container.innerHTML = '<div class="loading">No products yet. Add your first product!</div>';
                return;
            }
            container.innerHTML = products.map(product => `
                <div class="product-card">
                    <div class="product-image">${product.picture ? `<img src="${product.picture}">` : '📦'}</div>
                    <div class="product-info">
                        <div class="product-name">${product.name}</div>
                        <div class="product-barcode">Barcode: ${product.barcode}</div>
                        <div class="product-price">R${product.price}</div>
                    </div>
                    <div class="product-actions">
                        <button class="edit-btn" onclick="editProduct(${product.id})">Edit</button>
                        <button class="delete-btn" onclick="deleteProduct(${product.id})">Delete</button>
                    </div>
                </div>
            `).join('');
        }
        function showAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function closeModal() {
            document.getElementById('addModal').style.display = 'none';
            document.getElementById('productBarcode').value = '';
            document.getElementById('productName').value = '';
            document.getElementById('productPrice').value = '';
            document.getElementById('productPicture').value = '';
        }
        async function addProduct() {
            const formData = new FormData();
            formData.append('barcode', document.getElementById('productBarcode').value);
            formData.append('name', document.getElementById('productName').value);
            formData.append('price', document.getElementById('productPrice').value);
            formData.append('picture', document.getElementById('productPicture').files[0]);
            try {
                const response = await fetch('/api/merchant/products', { method: 'POST', body: formData });
                if (response.ok) { alert('Product added successfully'); closeModal(); loadProducts(); }
                else { const error = await response.json(); alert(error.error || 'Error adding product'); }
            } catch (error) { alert('Error adding product'); }
        }
        async function deleteProduct(id) {
            if (confirm('Are you sure you want to delete this product?')) {
                try {
                    const response = await fetch(`/api/merchant/products/${id}`, { method: 'DELETE' });
                    if (response.ok) { alert('Product deleted successfully'); loadProducts(); }
                    else { alert('Error deleting product'); }
                } catch (error) { alert('Error deleting product'); }
            }
        }
        function editProduct(id) { window.location.href = `/merchant-product-edit?id=${id}`; }
        loadProducts();
    </script>
</body>
</html>